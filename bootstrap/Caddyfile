{
	email {$VPS_OS_ACME_EMAIL:admin@example.com}
}

{$VPS_OS_DOMAIN:localhost} {
	encode zstd gzip

	# Control API (auth & rate limits enforced inside dashboard-api)
	handle /api/* {
		reverse_proxy dashboard-api:3001
	}

	# Management Web UI static bundle served via dashboard-api
	handle {
		reverse_proxy dashboard-api:3001
	}
}

# Dynamic per-app route configs managed by VPS OS
# (When routing a web-app domain, connect vps-os-caddy to that app's isolated network.)
import /etc/caddy/apps.d/*.caddy
