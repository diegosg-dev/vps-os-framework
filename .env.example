# VPS OS Core Configuration (Example - Copy to .env on the target VPS)
# Never commit a real .env file to Git.

VPS_OS_DOMAIN=localhost
VPS_OS_SITE_ADDRESS=localhost
VPS_OS_ACME_EMAIL=admin@example.com
VPS_OS_PUBLIC_IP=
VPS_OS_ADMIN_TOKEN=replace-with-generated-admin-token
VPS_OS_RUNTIME_TOKEN=replace-with-generated-runtime-token
VPS_OS_APPS_ROOT=/apps
VPS_OS_REGISTRY_DB=/vps-os/data/registry.db

# LLM Provider API (Step 11) — opencode | openai | anthropic | openrouter | nous | ollama
LLM_PROVIDER=opencode
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=replace-with-your-api-key

# Hermes CTO Gateway (Step 5)
HERMES_HOME=/vps-os/hermes
HERMES_API_SERVER_KEY=replace-with-generated-hermes-api-key
